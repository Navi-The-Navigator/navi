{
  "name": "navi",
  "displayName": "Navi",
  "description": "Ai empowered coding navigator.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:navi.sidebarWebview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Navi",
      "properties": {
        "navi.deepseekApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "DeepSeek API Key. Prefer environment variable `DEEPSEEK_API_KEY` in shared environments."
        },
        "navi.deepseekBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "DeepSeek OpenAI-compatible API base URL."
        },
        "navi.deepseekModel": {
          "type": "string",
          "default": "deepseek-reasoner",
          "description": "Model name for DeepSeek (default uses reasoning model)."
        },
        "navi.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for model responses."
        },
        "navi.recursionLimit": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 200,
          "description": "Max LangGraph reasoning/tool steps per request. Increase if the agent hits recursion limit."
        },
        "navi.mcpEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable loading tools from configured MCP servers."
        },
        "navi.mcpServersJson": {
          "type": "string",
          "default": "",
          "markdownDescription": "MCP server config JSON. Example: `{\"math\":{\"transport\":\"stdio\",\"command\":\"npx\",\"args\":[\"-y\",\"@modelcontextprotocol/server-math\"]}}`"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "naviSidebar",
          "title": "Navi",
          "icon": "media/navi.svg"
        }
      ]
    },
    "views": {
      "naviSidebar": [
        {
          "id": "navi.sidebarWebview",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "navi.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@langchain/core": "^1.1.38",
    "@langchain/langgraph": "^1.2.6",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.1"
  }
}
